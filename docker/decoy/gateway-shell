#!/bin/bash
# Login shell for the gateway's `admin` account.
#
# It is a normal bash shell with session auditing enabled. Every command the
# session is appended to a shared log keyed by the SSH client port so the
# operator can review sessions without modifying the service.

LOG="${GATEWAY_COMMAND_LOG:-/var/log/gateway/commands.tsv}"
CONN="${SSH_CONNECTION:-unknown}"

# SSH_CONNECTION is "<client ip> <client port> <server ip> <server port>".
CLIENT_PORT=$(printf '%s' "$CONN" | awk '{print $2}')
export GATEWAY_SESSION_TAG="port-${CLIENT_PORT:-unknown}"

log_command() {
    local cmd="$1"
    [ -n "$cmd" ] || return 0
    mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
    printf '%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)" \
        "$GATEWAY_SESSION_TAG" \
        "$(printf '%s' "$cmd" | base64 -w0)" >> "$LOG" 2>/dev/null || true
}

# `ssh host 'cmd'` arrives as: gateway-shell -c 'cmd'.
if [ "${1:-}" = "-c" ] && [ -n "${2:-}" ]; then
    log_command "$2"
    exec /bin/bash "$@"
fi

# Interactive PTY session: audit through PROMPT_COMMAND.
if [ -t 0 ] && [ -t 1 ]; then
    exec /bin/bash --rcfile /etc/gateway/bashrc -i
fi

exec /bin/bash "$@"
